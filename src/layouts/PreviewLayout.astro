---
import '../styles/preview.css';

interface Props {
	direction: 'review' | 'monograph' | 'field';
	label: string;
}
const { direction, label } = Astro.props;

const navItems = [
	'About',
	'Scholarship',
	'Spatial Trauma',
	'Creative Work',
	'Consulting',
	'Teaching',
	'Contact',
];
---

<!doctype html>
<html lang="en" data-direction={direction}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{label} — direction preview</title>
	</head>
	<body class="pv-body">
		<div class="pv-banner">
			Design preview &mdash; &ldquo;{label}&rdquo; &nbsp;·&nbsp;
			<a href="/preview/">compare all three</a> &nbsp;·&nbsp;
			<a href="/">back to the live site</a>
		</div>

		<header class="pv-header">
			<div class="pv-wrap pv-header-inner">
				<a class="pv-wordmark" href="/preview/">Gavin Keulks</a>
				<nav class="pv-nav" aria-label="Sample navigation">
					{
						navItems.map((item) => (
							<a href="#" aria-current={item === 'About' ? 'page' : undefined}>
								{item}
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main class="pv-wrap pv-main">
			<slot />
		</main>

		<footer class="pv-footer">
			<div class="pv-wrap">
				<p class="pv-label">Contact</p>
				<p>
					Department of English, Western Oregon University<br />
					345 Monmouth Avenue N, Monmouth, Oregon 97361
				</p>
				<p>
					<a href="https://martinamisweb.com">The Martin Amis Web</a>
					&nbsp;·&nbsp;
					<a href="https://www.linkedin.com/in/gavinkeulks/">LinkedIn</a>
				</p>
			</div>
		</footer>
	</body>
</html>
