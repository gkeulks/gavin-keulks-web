---
interface Props {
	title: string;
	blurb: string;
}
const { title, blurb } = Astro.props;
---

<div class="wrap">
	<article class="measure section-placeholder">
		<p class="eyebrow">In preparation</p>
		<h1>{title}</h1>
		<p class="blurb">{blurb}</p>
		<p class="note">
			This section is being built. In the meantime, the current site remains at{' '}
			<a href="https://wp.wou.education/keulksg/">wp.wou.education/keulksg</a>.
		</p>
	</article>
</div>

<style>
	.section-placeholder {
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(4rem, 12vw, 9rem);
	}

	.section-placeholder h1 {
		margin: 0.9rem 0 1.4rem;
	}

	.blurb {
		font-size: clamp(1.1rem, 1rem + 1vw, 1.28rem);
		line-height: 1.46;
		color: var(--color-ink-soft);
		margin: 0;
	}

	.note {
		margin-top: 2.5rem;
		font-family: var(--font-sans);
		font-size: 0.85rem;
		color: var(--color-ink-faint);
	}
</style>
