---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<div class="cols">
			<div class="col">
				<p class="label">Contact</p>
				<p>
					Department of English<br />
					Western Oregon University<br />
					345 Monmouth Avenue N<br />
					Monmouth, Oregon 97361
				</p>
				<p><a href="/contact/">Email &amp; enquiries</a></p>
			</div>
			<div class="col">
				<p class="label">Elsewhere</p>
				<p><a href="https://martinamisweb.com">The Martin Amis Web</a></p>
				<p><a href="https://www.linkedin.com/in/gavinkeulks/">LinkedIn</a></p>
				<p><a href="https://linktr.ee/gkeulks">Linktree</a></p>
			</div>
		</div>
		<p class="colophon">
			&copy; {year} Gavin Keulks. Photographs are the author&rsquo;s own; all
			rights reserved. &nbsp;<a href="#main">Back to top</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-line);
		margin-top: var(--space-section);
		padding-block: 2.75rem 3.25rem;
		font-family: var(--font-sans);
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	.cols {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem 3.5rem;
	}

	.col p {
		margin: 0 0 0.4rem;
	}

	.label {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		margin-bottom: 0.7rem !important;
	}

	.col a {
		color: var(--color-ink-soft);
	}

	.colophon {
		margin: 2.25rem 0 0;
		color: var(--color-ink-faint);
	}

	.colophon a {
		color: var(--color-ink-faint);
		white-space: nowrap;
	}

	@media (max-width: 34rem) {
		.cols {
			flex-direction: column;
			gap: 1.75rem;
		}
	}
</style>
