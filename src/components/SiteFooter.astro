---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<div class="cols">
			<div class="col">
				<p class="label">Contact</p>
				<p><span class="email" data-email="work">Email (work)</span></p>
				<p><span class="email" data-email="personal">Email (personal)</span></p>
				<noscript>
					<p>keulksg [at] wou.edu</p>
					<p>gkeulks [at] gmail.com</p>
				</noscript>
			</div>
			<div class="col">
				<p class="label">Address</p>
				<p>
					Department of English<br />
					Western Oregon University<br />
					345 Monmouth Avenue&nbsp;N<br />
					Monmouth, Oregon&nbsp;97361
				</p>
			</div>
			<div class="col">
				<p class="label">Elsewhere</p>
				<p><a href="https://linktr.ee/gkeulks">Linktree</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="https://www.linkedin.com/in/gavinkeulks/">LinkedIn</a></p>
				<p><a href="https://x.com/GavinKeulks">X (Twitter)</a></p>
				<p><a href="https://martinamisweb.com">The Martin Amis Web</a></p>
			</div>
		</div>
		<p class="colophon">
			&copy; {year} Gavin Keulks. Photographs are the author&rsquo;s own; all
			rights reserved. &nbsp;<a href="#main">Back to top</a>
		</p>
	</div>
</footer>

<script is:inline>
	/* Addresses are held in pieces and joined at runtime, so nothing matching
	   an address pattern appears anywhere in the served markup. Also drives
	   the Consulting page's enquiry link, which renders before this runs. */
	(function () {
		var parts = {
			work: ['keulksg', 'wou', 'edu'],
			personal: ['gkeulks', 'gmail', 'com'],
		};
		var slots = document.querySelectorAll('.email[data-email]');
		for (var i = 0; i < slots.length; i++) {
			var slot = slots[i];
			var p = parts[slot.getAttribute('data-email')];
			if (!p) continue;
			var a = document.createElement('a');
			a.href = 'mailto:' + p[0] + String.fromCharCode(64) + p[1] + '.' + p[2];
			a.textContent = slot.textContent;
			slot.replaceWith(a);
		}
	})();
</script>

<style>
	.site-footer {
		border-top: 1px solid var(--color-line);
		margin-top: var(--space-section);
		padding-block: 2.75rem 3.25rem;
		font-family: var(--font-sans);
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	.cols {
		display: grid;
		grid-template-columns: repeat(3, max-content);
		justify-content: start;
		column-gap: clamp(2.5rem, 7vw, 5rem);
		row-gap: 2.25rem;
	}

	.col p {
		margin: 0 0 0.4rem;
		white-space: nowrap;
	}

	.label {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		margin-bottom: 0.7rem !important;
	}

	.col a {
		color: var(--color-ink-soft);
	}

	.colophon {
		margin: 2.25rem 0 0;
		color: var(--color-ink-faint);
		white-space: normal;
	}

	.colophon a {
		color: var(--color-ink-faint);
		white-space: nowrap;
	}

	@media (max-width: 34rem) {
		.cols {
			grid-template-columns: 1fr;
			row-gap: 1.75rem;
		}
	}
</style>
