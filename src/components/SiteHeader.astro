---
import { sections } from '../data/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
---

<header class:list={['site-header', { home: isHome }]}>
	<div class="wrap inner">
		{
			!isHome && (
				<>
					<a class="wordmark" href="/">Gavin Keulks</a>
					<p class="role">
						Professor of Literature &amp; Film, Western Oregon University
					</p>
				</>
			)
		}
		<button
			class="nav-toggle"
			id="nav-toggle"
			aria-expanded="false"
			aria-controls="primary-nav"
		>
			<span class="nav-toggle-bars" aria-hidden="true"></span>
			<span>Menu</span>
		</button>
		<nav class="primary-nav" id="primary-nav" aria-label="Primary">
			{isHome && <a href="/" class="active">Home</a>}
			{
				sections.map((link) => (
					<a
						href={`/${link.slug}/`}
						class={path === `/${link.slug}` ? 'active' : ''}
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const nav = document.getElementById('primary-nav');
	toggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});
	nav?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).tagName === 'A') {
			nav.classList.remove('open');
			toggle?.setAttribute('aria-expanded', 'false');
		}
	});
</script>

<style>
	.site-header {
		background: var(--color-paper);
		border-bottom: 1px solid var(--color-line);
	}

	.inner {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: baseline;
		column-gap: 1.5rem;
		row-gap: 0.12rem;
		padding-block: 1.75rem 1.3rem;
	}

	.site-header.home .inner {
		padding-block: 1.4rem 1.1rem;
	}

	.wordmark {
		grid-column: 1;
		grid-row: 1;
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		letter-spacing: -0.005em;
		color: var(--color-ink);
		text-decoration: none;
	}

	.role {
		grid-column: 1 / -1;
		grid-row: 2;
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.72rem;
		letter-spacing: 0.015em;
		color: var(--color-ink-faint);
	}

	.primary-nav {
		grid-column: 2;
		grid-row: 1;
		justify-self: end;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.35rem 0.9rem;
	}

	.site-header.home .primary-nav {
		grid-column: 1 / -1;
		justify-self: start;
		justify-content: flex-start;
	}

	.primary-nav a {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--color-ink-faint);
		text-decoration: none;
		white-space: nowrap;
		padding-bottom: 0.15rem;
		border-bottom: 1px solid transparent;
	}

	.primary-nav a:hover {
		color: var(--color-ink);
	}

	.primary-nav a.active {
		color: var(--color-ink);
		border-bottom-color: var(--color-ink);
	}

	.nav-toggle {
		display: none;
		grid-column: 2;
		grid-row: 1;
		justify-self: end;
		align-self: center;
		align-items: center;
		gap: 0.5rem;
		background: transparent;
		border: 1px solid var(--color-line-strong);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		padding: 0.45rem 0.8rem;
		border-radius: 2px;
		cursor: pointer;
	}

	.site-header.home .nav-toggle {
		grid-column: 1;
		justify-self: start;
	}

	.nav-toggle-bars,
	.nav-toggle-bars::before,
	.nav-toggle-bars::after {
		display: block;
		width: 14px;
		height: 2px;
		background: var(--color-ink);
		content: '';
	}

	.nav-toggle-bars {
		position: relative;
	}

	.nav-toggle-bars::before {
		position: absolute;
		top: -4px;
	}

	.nav-toggle-bars::after {
		position: absolute;
		top: 4px;
	}

	@media (max-width: 48rem) {
		.nav-toggle {
			display: inline-flex;
		}

		.primary-nav,
		.site-header.home .primary-nav {
			grid-column: 1 / -1;
			grid-row: 3;
			display: none;
			flex-direction: column;
			justify-content: flex-start;
			gap: 0;
			margin-top: 0.5rem;
		}

		.primary-nav.open {
			display: flex;
		}

		.primary-nav a {
			padding: 0.8rem 0;
			font-size: 0.85rem;
			border-bottom: 1px solid var(--color-line);
			width: 100%;
		}

		.primary-nav a.active {
			border-bottom-color: var(--color-ink);
		}
	}
</style>
