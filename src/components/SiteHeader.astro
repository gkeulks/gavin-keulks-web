---
import { sections } from '../data/nav';

interface Props {
	/** mock-up only: show the proposed Digital Work item after Scholarship */
	previewDigitalWork?: boolean;
}

const { previewDigitalWork = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

/* Mock-up of option B: the work first, then the person and the service as a
   quieter group after a divider. Every other page renders the flat list. */
const bySlug = (slug: string) => sections.find((s) => s.slug === slug)!;
const digitalWork = { slug: 'preview/digital-work', title: 'Digital Work' };
const links = previewDigitalWork
	? [bySlug('books'), bySlug('scholarship'), digitalWork, bySlug('fieldwork'), bySlug('creative-work')]
	: sections;
const quietLinks = previewDigitalWork
	? [bySlug('about'), bySlug('teaching'), bySlug('consulting')]
	: [];
---

<header class="site-header">
	<div class="wrap inner">
		<a class="wordmark" href="/">Gavin Keulks</a>
		<button
			class="nav-toggle"
			id="nav-toggle"
			aria-expanded="false"
			aria-controls="primary-nav"
		>
			<span class="nav-toggle-bars" aria-hidden="true"></span>
			<span>Menu</span>
		</button>
		<nav class="primary-nav" id="primary-nav" aria-label="Primary">
			{
				links.map((link) => (
					<a
						href={`/${link.slug}/`}
						class={path === `/${link.slug}` ? 'active' : ''}
					>
						{link.title}
					</a>
				))
			}
			{quietLinks.length > 0 && <span class="nav-sep" aria-hidden="true" />}
			{
				quietLinks.map((link) => (
					<a
						href={`/${link.slug}/`}
						class={path === `/${link.slug}` ? 'quiet active' : 'quiet'}
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const nav = document.getElementById('primary-nav');
	toggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});
	nav?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).tagName === 'A') {
			nav.classList.remove('open');
			toggle?.setAttribute('aria-expanded', 'false');
		}
	});
</script>

<style>
	.site-header {
		background: var(--color-paper);
		border-bottom: 1px solid var(--color-line);
	}

	.inner {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: baseline;
		column-gap: 1.5rem;
		row-gap: 0.5rem;
		padding-block: 1.6rem 1.25rem;
	}

	.wordmark {
		grid-column: 1;
		grid-row: 1;
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		letter-spacing: -0.005em;
		color: var(--color-ink);
		text-decoration: none;
	}

	.primary-nav {
		grid-column: 2;
		grid-row: 1;
		justify-self: end;
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.35rem 0.9rem;
	}

	.primary-nav a {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--color-ink-faint);
		text-decoration: none;
		white-space: nowrap;
		padding-bottom: 0.15rem;
		border-bottom: 1px solid transparent;
	}

	.primary-nav a:hover {
		color: var(--color-ink);
	}

	.primary-nav a.active {
		color: var(--color-ink);
		border-bottom-color: var(--color-ink);
	}

	/* option B mock-up: the work group reads a step darker than the quiet one */
	.primary-nav:has(.nav-sep) a:not(.quiet) {
		color: var(--color-ink-soft);
	}

	.primary-nav a.quiet {
		color: var(--color-ink-faint);
		font-weight: 400;
	}

	.primary-nav a.quiet:hover,
	.primary-nav:has(.nav-sep) a:hover,
	.primary-nav:has(.nav-sep) a.active {
		color: var(--color-ink);
	}

	.nav-sep {
		align-self: center;
		width: 1px;
		height: 0.8rem;
		background: var(--color-line-strong);
		margin-inline: 0.15rem;
	}

	.nav-toggle {
		display: none;
		grid-column: 2;
		grid-row: 1;
		justify-self: end;
		align-self: center;
		align-items: center;
		gap: 0.5rem;
		background: transparent;
		border: 1px solid var(--color-line-strong);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		padding: 0.45rem 0.8rem;
		border-radius: 2px;
		cursor: pointer;
	}

	.nav-toggle-bars,
	.nav-toggle-bars::before,
	.nav-toggle-bars::after {
		display: block;
		width: 14px;
		height: 2px;
		background: var(--color-ink);
		content: '';
	}

	.nav-toggle-bars {
		position: relative;
	}

	.nav-toggle-bars::before {
		position: absolute;
		top: -4px;
	}

	.nav-toggle-bars::after {
		position: absolute;
		top: 4px;
	}

	@media (max-width: 48rem) {
		.nav-toggle {
			display: inline-flex;
		}

		.primary-nav {
			grid-column: 1 / -1;
			grid-row: 2;
			/* the desktop rule pins the nav to the right; the open mobile menu
			   must span the full width so its items start on the page's left
			   edge, level with the wordmark */
			justify-self: stretch;
			display: none;
			flex-direction: column;
			justify-content: flex-start;
			gap: 0;
			margin-top: 0.5rem;
		}

		.primary-nav.open {
			display: flex;
		}

		.primary-nav a {
			padding: 0.8rem 0;
			font-size: 0.85rem;
			border-bottom: 1px solid var(--color-line);
			width: 100%;
		}

		.primary-nav a.active {
			border-bottom-color: var(--color-ink);
		}

		/* in the open menu the divider becomes a gap before the quiet group */
		.nav-sep {
			width: 100%;
			height: 1.25rem;
			margin: 0;
			background: none;
		}

		.nav-sep + a {
			border-top: 1px solid var(--color-line);
		}
	}
</style>
