---
import { sections } from '../data/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
---

<header class:list={['site-header', { home: isHome }]}>
	<div class="wrap inner">
		{
			!isHome && (
				<a class="wordmark" href="/">
					<span class="name">Gavin Keulks</span>
					<span class="role">
						Professor of Literature &amp; Film, Western Oregon University
					</span>
				</a>
			)
		}
		<button
			class="nav-toggle"
			id="nav-toggle"
			aria-expanded="false"
			aria-controls="primary-nav"
		>
			<span class="nav-toggle-bars" aria-hidden="true"></span>
			<span>Menu</span>
		</button>
		<nav class="primary-nav" id="primary-nav" aria-label="Primary">
			<a href="/" class={path === '/' ? 'active' : ''}>Home</a>
			{
				sections.map((link) => (
					<a
						href={`/${link.slug}/`}
						class={path === `/${link.slug}` ? 'active' : ''}
					>
						{link.title}
					</a>
				))
			}
			<a
				href="/contact/"
				class={path === '/contact' ? 'active' : ''}
			>
				Contact
			</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const nav = document.getElementById('primary-nav');
	toggle?.addEventListener('click', () => {
		const isOpen = nav?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});
	nav?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).tagName === 'A') {
			nav.classList.remove('open');
			toggle?.setAttribute('aria-expanded', 'false');
		}
	});
</script>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-line);
		background: var(--color-paper);
	}

	.inner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: baseline;
		gap: 0.75rem 1.5rem;
		padding-block: 1.6rem 0;
	}

	/* Home: no wordmark — the hero carries the name. Just the nav row. */
	.site-header.home .inner {
		grid-template-columns: 1fr;
		padding-block: 1rem 0;
	}

	.site-header.home .primary-nav {
		margin-top: 0;
	}

	.wordmark {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		text-decoration: none;
		color: var(--color-ink);
	}

	.wordmark .name {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	.wordmark .role {
		font-family: var(--font-sans);
		font-size: 0.74rem;
		letter-spacing: 0.02em;
		color: var(--color-ink-faint);
	}

	.primary-nav {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.4rem;
		margin-top: 1.1rem;
	}

	.primary-nav a {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		color: var(--color-ink-soft);
		text-decoration: none;
		padding: 0.5rem 0;
		border-bottom: 2px solid transparent;
		white-space: nowrap;
	}

	.primary-nav a:hover {
		color: var(--color-ink);
	}

	.primary-nav a.active {
		color: var(--color-ink);
		border-bottom-color: var(--color-accent);
	}

	.nav-toggle {
		display: none;
		align-items: center;
		gap: 0.55rem;
		background: transparent;
		border: 1px solid var(--color-line-strong);
		color: var(--color-ink);
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 600;
		padding: 0.5rem 0.85rem;
		border-radius: 2px;
		cursor: pointer;
		align-self: center;
	}

	.nav-toggle-bars,
	.nav-toggle-bars::before,
	.nav-toggle-bars::after {
		display: block;
		width: 15px;
		height: 2px;
		background: var(--color-ink);
		content: '';
	}

	.nav-toggle-bars {
		position: relative;
	}

	.nav-toggle-bars::before {
		position: absolute;
		top: -5px;
	}

	.nav-toggle-bars::after {
		position: absolute;
		top: 5px;
	}

	@media (max-width: 46rem) {
		.inner {
			padding-bottom: 1rem;
		}

		.nav-toggle {
			display: flex;
		}

		.site-header.home .nav-toggle {
			justify-self: start;
		}

		.primary-nav {
			display: none;
			flex-direction: column;
			gap: 0;
			margin-top: 0.75rem;
			width: 100%;
		}

		.primary-nav.open {
			display: flex;
		}

		.primary-nav a {
			padding: 0.85rem 0;
			border-bottom: 1px solid var(--color-line);
			width: 100%;
		}

		.primary-nav a.active {
			border-bottom-color: var(--color-accent);
		}
	}
</style>
