---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact"
	description="Gavin Keulks — department address and email, Western Oregon University."
>
	<div class="wrap">
		<header class="page-head">
			<h1>Contact</h1>
			<p class="page-intro">
				Enquiries about program review, writing, or the Martin&nbsp;Amis Web are
				all welcome.
			</p>
		</header>

		<section class="details">
			<div class="block">
				<p class="label">Email</p>
				<p class="email">
					<span id="email-slot">keulksg [at] wou.edu</span>
				</p>
			</div>

			<div class="block">
				<p class="label">Post</p>
				<p>
					Department of English<br />
					Western Oregon University<br />
					345 Monmouth Avenue&nbsp;N<br />
					Monmouth, Oregon&nbsp;97361
				</p>
			</div>
		</section>
	</div>
</Layout>

<script is:inline>
	(function () {
		var slot = document.getElementById('email-slot');
		if (!slot) return;
		var user = 'keulksg';
		var domain = 'wou.edu';
		var a = document.createElement('a');
		a.href = 'mailto:' + user + '@' + domain;
		a.textContent = user + '@' + domain;
		slot.replaceWith(a);
	})();
</script>

<style>
	.page-head {
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(1.75rem, 4vw, 3rem);
	}

	.page-head h1 {
		margin: 0 0 1rem;
	}

	.page-intro {
		font-size: clamp(1.1rem, 1rem + 0.6vw, 1.3rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
		max-width: 42rem;
		text-wrap: balance;
	}

	.details {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 2.5rem;
		padding-block: clamp(2.5rem, 6vw, 3.75rem);
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
		max-width: 42rem;
	}

	.label {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		margin: 0 0 0.6rem;
	}

	.block p {
		margin: 0;
		line-height: 1.55;
	}

	.email {
		font-size: 1.05rem;
	}
</style>
