---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SlideDeck from '../components/SlideDeck.astro';

const laundriesMods = import.meta.glob<{ default: ImageMetadata }>('../assets/images/fieldwork/laundries/*.jpg', { eager: true });
const laundries = Object.keys(laundriesMods).sort().map((p) => laundriesMods[p].default);
const estatesMods = import.meta.glob<{ default: ImageMetadata }>('../assets/images/fieldwork/estates/*.jpg', { eager: true });
const estates = Object.keys(estatesMods).sort().map((p) => estatesMods[p].default);
const contestedMods = import.meta.glob<{ default: ImageMetadata }>('../assets/images/fieldwork/contested/*.jpg', { eager: true });
const contested = Object.keys(contestedMods).sort().map((p) => contestedMods[p].default);

const deckMods = import.meta.glob<{ default: ImageMetadata }>('../assets/images/decks/acis-2026/*.jpg', { eager: true });
const slides = Object.keys(deckMods).sort().map((k) => deckMods[k].default);

/* One large variant per photograph, for the lightbox. */
const big = async (list: ImageMetadata[]) =>
	Promise.all(list.map((s) => getImage({ src: s, width: 2000, format: 'webp' })));
const fullLaundries = await big(laundries);
const fullEstates = await big(estates);
const fullContested = await big(contested);
---

<Layout
	title="Fieldwork"
	description="Gavin Keulks — site-based photographs and conference papers toward a book on spatial trauma in Ireland and Northern Ireland."
>
	<div class="wrap">
		<header class="page-head">
			<h1>Fieldwork</h1>
			<p class="page-intro">
				Toward a book on the reclamation of traumatic spaces in Ireland.
			</p>
		</header>

		<section class="project">
			<p>
				Site-based photographs, my own, of places rather than people: Magdalene
				Laundries, Mother and Baby Homes, Famine Memorials, the ghost estates left
				by the collapse of the Celtic&nbsp;Tiger, and the contested walls of
				Belfast and Dublin.
			</p>
			<p>
				They inform my final scholarly book, on spatial trauma in Ireland and
				Northern&nbsp;Ireland &mdash; and how such spaces are reclaimed,
				memorialized, or left to stand. The argument has been taking shape in
				conference papers since 2014.
			</p>
			<p>
				This webpage will likely persist, and become even more important upon the
				book&rsquo;s eventual publication. Publishers face financial constraints
				with image-heavy manuscripts. This webpage can help offset that pressure
				while simultaneously providing visual support for the chapters&rsquo;
				arguments.
			</p>
		</section>
	</div>

	<div class="wrap-wide">
		<section class="strand">
			<h2>Magdalene Laundries and Mother and Baby Homes</h2>
			<ul class="cite-list cite-wide">
				<li>
					<span class="cite-title"
						>&ldquo;Home (Dis)Rule: Magdalene Laundries, Mother and Baby Homes, and
						Ghost Estates.&rdquo;</span
					>{' '}
					American Conference for Irish Studies. Denver,&nbsp;CO, 2026.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;Ireland&rsquo;s Last Magdalene Laundry.&rdquo;</span
					>{' '}
					Northeast Modern Language Association. Boston,&nbsp;MA, 2024.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;Excavating History: Justice for Irish Magdalenes.&rdquo;</span
					>{' '}
					Northeast Modern Language Association. Niagara,&nbsp;NY, 2023.
				</li>
			</ul>
		</section>
	</div>

	<div class="wrap-wide gallery-wrap">
		<ul class="gallery">
				<li>
					<button class="shot" type="button" data-full={fullLaundries[0].src}>
						<Image class="shot-img" src={laundries[0]} alt="A roofless stone building, a white cross fixed to the gable"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullLaundries[1].src}>
						<Image class="shot-img" src={laundries[1]} alt="A long derelict institutional block, windows boarded, across a wet yard"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullLaundries[2].src}>
						<Image class="shot-img" src={laundries[2]} alt="A gothic red-brick range, ivy grown over its lower storey"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullLaundries[3].src}>
						<Image class="shot-img" src={laundries[3]} alt="A black iron gate, a memorial plaque and flowers set into the wall beside it"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullLaundries[4].src}>
						<Image class="shot-img" src={laundries[4]} alt="Iron railings hung the length of a street with children's shoes and ribbons"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullLaundries[5].src}>
						<Image class="shot-img" src={laundries[5]} alt="A white teddy bear, flowers and small shoes tied to iron railings"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
		</ul>
	</div>
	<div class="wrap-wide">
		<section class="strand">
			<h2>Ghost Estates, Famine Memorials, and Topographical Scars</h2>
			<ul class="cite-list cite-wide">
				<li>
					<span class="cite-title"
						>&ldquo;Irish Spatial Texts and Topographical Scars.&rdquo;</span
					>{' '}
					Northeast Modern Language Association. Philadelphia,&nbsp;PA, 2025.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;Thwarted Alchemy: Irish Ghost Estates and Post-Celtic-Tiger
						Literature.&rdquo;</span
					>{' '}
					Humanities and Education Research Association. Chicago,&nbsp;IL, 2018.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;Topographical Scars: Economic Collapse, Mass Emigration, and
						Irish Tourism.&rdquo;</span
					>{' '}
					Popular and American Culture Association. New&nbsp;Orleans,&nbsp;LA, 2015.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;Trauma Memorials and Historical Geography: Ghost Estates as
						Modern-day Famine Walls.&rdquo;</span
					>{' '}
					Transatlantic Connections&nbsp;II. Donegal, Ireland, 2015.
				</li>
			</ul>
		</section>
	</div>

	<div class="wrap-wide gallery-wrap">
		<ul class="gallery">
				<li>
					<button class="shot" type="button" data-full={fullEstates[0].src}>
						<Image class="shot-img" src={estates[0]} alt="A stone enclosure with a white cross and a memorial plaque to the Famine dead"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullEstates[1].src}>
						<Image class="shot-img" src={estates[1]} alt="Snow lying over an empty burial field, a small cross at its edge"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullEstates[2].src}>
						<Image class="shot-img" src={estates[2]} alt="The grille of a wrecked Rolls-Royce standing in long grass"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullEstates[3].src}>
						<Image class="shot-img" src={estates[3]} alt="An unfinished estate road, wire fencing and scattered debris"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullEstates[4].src}>
						<Image class="shot-img" src={estates[4]} alt="An estate street of finished houses, a concrete pipe left in the foreground"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullEstates[5].src}>
						<Image class="shot-img" src={estates[5]} alt="A terrace of new houses with every opening boarded in orange"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
		</ul>
	</div>
	<div class="wrap-wide">
		<section class="strand">
			<h2>Belfast, Dublin, and Contested Space</h2>
			<ul class="cite-list cite-wide">
				<li>
					<span class="cite-title"
						>&ldquo;Politics and the Humanities in Belfast Street Art.&rdquo;</span
					>{' '}
					Humanities and Education Research Association. Chicago,&nbsp;IL, 2020.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;An Art-walk in Belfast: Stepping beyond Politics.&rdquo;</span
					>{' '}
					American Conference for Irish Studies. Boston,&nbsp;MA, 2019.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;Slouching towards Belfast to be Born: Apolitical Street-art in
						Belfast.&rdquo;</span
					>{' '}
					Popular and American Culture Association. Washington,&nbsp;DC, 2019.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;Between the Lanes: Politics and the Humanities in Irish
						Street-art.&rdquo;</span
					>{' '}
					Humanities and Education Research Association. San&nbsp;Diego,&nbsp;CA,
					2017.
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;&lsquo;What Rough Beast&rsquo;: Integrated and Conflicted Spaces
						in Dublin.&rdquo;</span
					>{' '}
					American Conference on Irish Studies. Dublin, Ireland, 2014.
				</li>
			</ul>
		</section>
	</div>

	<div class="wrap-wide gallery-wrap">
		<ul class="gallery">
				<li>
					<button class="shot" type="button" data-full={fullContested[0].src}>
						<Image class="shot-img" src={contested[0]} alt="A photorealist mural of a night city filling a gable wall"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullContested[1].src}>
						<Image class="shot-img" src={contested[1]} alt="A painted shopfront reading Goodbye above a street"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullContested[2].src}>
						<Image class="shot-img" src={contested[2]} alt="A street wall covered end to end in layered graffiti"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullContested[3].src}>
						<Image class="shot-img" src={contested[3]} alt="A peace wall painted with the words Smash the wall, separation"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullContested[4].src}>
						<Image class="shot-img" src={contested[4]} alt="A peace wall running beside a wet road, murals along its length"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
				<li>
					<button class="shot" type="button" data-full={fullContested[5].src}>
						<Image class="shot-img" src={contested[5]} alt="Rusted steel peace gates standing open across a road"
							widths={[373, 560, 746]} sizes="(max-width: 46rem) 90vw, 373px" />
					</button>
				</li>
		</ul>
	</div>

	<SlideDeck
		slides={slides}
		title="Home (Dis)Rule: Magdalene Laundries, Mother and Baby Homes, and Ghost Estates"
		meta="American Conference for Irish Studies, 2026"
		wide
	/>

	<dialog class="shot-modal" data-shot-modal aria-label="Photograph, enlarged">
		<button class="shot-close" type="button" data-shot-close aria-label="Close">&times;</button>
		<img data-shot-img alt="" />
	</dialog>
</Layout>

<script>
	const modal = document.querySelector('[data-shot-modal]') as HTMLDialogElement | null;
	const img = document.querySelector('[data-shot-img]') as HTMLImageElement | null;
	document.querySelectorAll<HTMLButtonElement>('.shot').forEach((btn) => {
		btn.addEventListener('click', () => {
			if (!modal || !img) return;
			img.src = btn.dataset.full ?? '';
			img.alt = btn.querySelector('img')?.alt ?? '';
			modal.showModal();
		});
	});
	document.querySelector('[data-shot-close]')?.addEventListener('click', () => modal?.close());
	modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
</script>

<style>
	.page-head {
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(1.75rem, 4vw, 3rem);
	}

	.page-head h1 {
		margin: 0 0 1rem;
	}

	.page-intro {
		font-size: clamp(1.1rem, 1rem + 0.6vw, 1.3rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
		max-width: 42rem;
		text-wrap: pretty;
	}

	.project {
		padding-block: clamp(2.5rem, 6vw, 3.75rem);
		border-top: 1px solid var(--color-line);
		max-width: 42rem;
	}

	.project p {
		margin: 0 0 1.15rem;
	}

	.project p:last-child {
		margin-bottom: 0;
	}

	.strand {
		padding-block: clamp(2.25rem, 5vw, 3.25rem) 0;
		border-top: 1px solid var(--color-line);
	}

	.strand h2 {
		margin: 0 0 1.5rem;
	}

	/* Short records, so they take the wide band as three columns and land on
	   the same edges as the photographs below them. Continuous prose above
	   keeps its own measure. */
	.cite-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cite-wide {
		columns: 3;
		column-gap: 1.5rem;
	}

	.cite-list li {
		break-inside: avoid;
		padding-block: 0 1.1rem;
		padding-left: 1.4rem;
		text-indent: -1.4rem;
		color: var(--color-ink-soft);
		font-size: 1rem;
		line-height: 1.5;
		text-wrap: pretty;
	}

	.cite-title {
		color: var(--color-ink);
	}

	.gallery-wrap {
		padding-block: clamp(1.75rem, 3.5vw, 2.5rem) clamp(2.5rem, 5vw, 3.5rem);
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shot {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
		border-radius: 2px;
	}

	.shot-img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 2px;
	}

	.shot:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	.shot-modal {
		border: 0;
		padding: 0;
		max-width: 94vw;
		max-height: 94vh;
		background: transparent;
	}

	.shot-modal::backdrop {
		background: rgb(0 0 0 / 0.82);
	}

	.shot-modal img {
		display: block;
		max-width: 94vw;
		max-height: 94vh;
		width: auto;
		height: auto;
	}

	.shot-close {
		position: fixed;
		top: 1rem;
		right: 1.25rem;
		border: 0;
		background: none;
		color: #fff;
		font-size: 2rem;
		line-height: 1;
		cursor: pointer;
	}

	@media (max-width: 46rem) {
		.gallery {
			grid-template-columns: 1fr;
		}

		.cite-wide {
			columns: 1;
		}
	}
</style>
