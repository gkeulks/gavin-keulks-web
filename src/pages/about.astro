<style>
	.page-head {
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(1.75rem, 4vw, 3rem);
	}

	.page-head h1 {
		margin: 0 0 1rem;
	}

	.page-intro {
		font-size: clamp(1.1rem, 1rem + 0.6vw, 1.3rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
		max-width: 42rem;
		text-wrap: balance;
	}

	.bio {
		padding-block: clamp(2.5rem, 6vw, 3.75rem);
		border-top: 1px solid var(--color-line);
		max-width: 42rem;
	}

	.bio p {
		margin: 0 0 1.15rem;
	}

	.bio p:last-child {
		margin-bottom: 0;
	}

	.cv-line {
		margin: 0;
		text-align: center;
		padding-block: 1.35rem;
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
		font-family: var(--font-sans);
		font-size: 0.85rem;
		letter-spacing: 0.01em;
	}

	.cv-line a {
		color: var(--color-ink-soft);
	}

	.record {
		padding-block: clamp(2.25rem, 5vw, 3.25rem);
		border-top: 1px solid var(--color-line);
	}

	.record:last-child {
		border-bottom: 1px solid var(--color-line);
	}

	.record h2 {
		margin: 0 0 1.6rem;
	}

	.record-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.record-row {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 0 1.5rem;
		padding-block: 0.65rem;
		align-items: baseline;
	}

	.record-row + .record-row {
		border-top: 1px solid var(--color-line);
	}

	.record-year {
		font-family: var(--font-sans);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		color: var(--color-ink-faint);
		font-variant-numeric: tabular-nums;
	}

	.record-item {
		font-size: 1.05rem;
		line-height: 1.45;
	}

	.record-note {
		display: block;
		margin-top: 0.2rem;
		font-family: var(--font-sans);
		font-size: 0.82rem;
		line-height: 1.5;
		color: var(--color-ink-faint);
	}

	@media (max-width: 34rem) {
		.record-row {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
