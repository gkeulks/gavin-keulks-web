---
import Layout from '../layouts/Layout.astro';
import { sections } from '../data/nav';
---

<Layout title="Gavin Keulks" bareTitle description="Gavin Keulks — Professor of Literature and Film at Western Oregon University.">
	<div class="wrap">
		<div class="home measure-wide">
			<section class="intro">
				<h1>Gavin Keulks</h1>
				<p class="lede">
					Professor of literature and film at Western Oregon University,
					specialising in twentieth-century English and Irish fiction of the
					postwar period. Editor of{' '}
					<em>The Cambridge Companion to Martin Amis</em> and administrator of
					the Martin Amis Web since 2006. Current work turns toward Irish
					traumatic spaces &mdash; and toward a first novel.
				</p>
			</section>

			<nav class="index" aria-label="Sections">
				<ul>
					{
						sections.map((s) => (
							<li>
								<a href={`/${s.slug}/`}>
									<span class="index-title">{s.title}</span>
									<span class="index-blurb">{s.blurb}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<p class="scaffold-note">
				This site is under construction. The current site remains at{' '}
				<a href="https://wp.wou.education/keulksg/">wp.wou.education/keulksg</a>.
			</p>
		</div>
	</div>
</Layout>

<style>
	.intro {
		padding-block: clamp(3.5rem, 10vw, 6.5rem) clamp(2.5rem, 6vw, 4rem);
	}

	.intro h1 {
		margin: 0 0 1.5rem;
	}

	.lede {
		font-size: clamp(1.25rem, 2.6vw, 1.55rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
	}

	.index {
		border-top: 1px solid var(--color-line);
	}

	.index ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.index li {
		border-bottom: 1px solid var(--color-line);
	}

	.index a {
		display: grid;
		grid-template-columns: minmax(12rem, 18rem) 1fr;
		gap: 0.5rem 2.5rem;
		padding: 1.5rem 0;
		text-decoration: none;
		color: var(--color-ink);
	}

	.index a:hover .index-title {
		color: var(--color-accent);
	}

	.index-title {
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-weight: 500;
	}

	.index-blurb {
		font-size: 1.02rem;
		color: var(--color-ink-soft);
		align-self: center;
	}

	.scaffold-note {
		margin-top: 2.5rem;
		font-family: var(--font-sans);
		font-size: 0.88rem;
		color: var(--color-ink-faint);
	}

	@media (max-width: 40rem) {
		.index a {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}

		.index-blurb {
			font-size: 0.96rem;
		}
	}
</style>
