---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { sections } from '../data/nav';
import portrait from '../assets/images/portrait.jpg';
---

<Layout
	title="Gavin Keulks"
	bareTitle
	description="Gavin Keulks — writer and scholar. Three books on the postwar English and Irish novel, a first novel in progress, and photographs toward a book on Irish traumatic spaces."
>
	<div class="wrap">
		<section class="intro">
			<div class="intro-text">
				<h1>Gavin Keulks</h1>
				<p class="lede">
					Professor of literature and film at Western Oregon University,
					specialising in twentieth-century English and Irish fiction of the
					postwar period. Editor of{' '}
					<em>The Cambridge Companion to Martin Amis</em> and administrator of
					the Martin Amis Web since 2006. Current major projects include
					publishing my first novel and beginning my final scholarly book, on
					Irish traumatic spaces.
				</p>
			</div>
			<Image
				class="portrait"
				src={portrait}
				alt="Gavin Keulks"
				widths={[256, 384, 512]}
				sizes="(max-width: 34rem) 60vw, 15rem"
			/>
		</section>

		<nav class="index" aria-label="Sections">
			{
				sections.map((s) => (
					<a class="index-item" href={`/${s.slug}/`}>
						<span class="index-title">{s.title}</span>
						<span class="index-blurb">{s.blurb}</span>
					</a>
				))
			}
		</nav>

		<p class="scaffold-note">
			This site is under construction. The current site remains at{' '}
			<a href="https://wp.wou.education/keulksg/" target="_blank" rel="noopener noreferrer">wp.wou.education/keulksg</a>.
		</p>
	</div>
</Layout>

<style>
	.intro {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: start;
		gap: 2.5rem;
		padding-block: clamp(3rem, 8vw, 5rem) clamp(3.5rem, 9vw, 6.5rem);
	}

	.intro h1 {
		margin: 0 0 1.5rem;
	}

	.lede {
		font-size: clamp(1.15rem, 1rem + 0.8vw, 1.35rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
		max-width: 34rem;
	}

	.portrait {
		width: 15rem;
		height: auto;
		object-fit: cover;
		border: 1px solid var(--color-line-strong);
	}

	.index {
		display: block;
		border-top: 1px solid var(--color-line);
	}

	.index-item {
		display: block;
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--color-line);
		text-decoration: none;
		color: var(--color-ink);
	}

	.index-title {
		display: block;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.index-item:hover .index-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.16em;
	}

	.index-blurb {
		display: block;
		margin-top: 0.35rem;
		font-size: 1.02rem;
		line-height: 1.45;
		color: var(--color-ink-soft);
	}

	.scaffold-note {
		margin-top: 2.75rem;
		font-family: var(--font-sans);
		font-size: 0.84rem;
		color: var(--color-ink-faint);
	}

	@media (max-width: 34rem) {
		.intro {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.portrait {
			width: min(60vw, 14rem);
			order: -1;
		}
	}
</style>
