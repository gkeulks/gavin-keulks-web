---
import Layout from '../layouts/Layout.astro';
import { sections } from '../data/nav';
---

<Layout
	title="Gavin Keulks"
	bareTitle
	description="Gavin Keulks — Professor of Literature and Film at Western Oregon University."
>
	<div class="wrap">
		<section class="intro">
			<h1>Gavin Keulks</h1>
			<p class="lede">
				Professor of literature and film at Western Oregon University,
				specialising in twentieth-century English and Irish fiction of the
				postwar period. Editor of{' '}
				<em>The Cambridge Companion to Martin Amis</em> and administrator of the
				Martin Amis Web since 2006. Current major projects include publishing my
				first novel and beginning my final scholarly book, on Irish traumatic
				spaces.
			</p>
		</section>

		<nav class="index" aria-label="Sections">
			{
				sections.map((s) => (
					<a class="index-item" href={`/${s.slug}/`}>
						<span class="index-title">{s.title}</span>
						<span class="index-blurb">{s.blurb}</span>
					</a>
				))
			}
		</nav>

		<p class="scaffold-note">
			This site is under construction. The current site remains at{' '}
			<a href="https://wp.wou.education/keulksg/">wp.wou.education/keulksg</a>.
		</p>
	</div>
</Layout>

<style>
	.intro {
		padding-block: clamp(3rem, 9vw, 5.5rem) clamp(1.75rem, 4vw, 2.75rem);
	}

	.intro h1 {
		margin: 0 0 1.6rem;
	}

	.lede {
		font-size: clamp(1.2rem, 2.2vw, 1.4rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
	}

	.index {
		display: block;
		border-top: 1px solid var(--color-line);
	}

	.index-item {
		display: block;
		padding: 1.6rem 0;
		border-bottom: 1px solid var(--color-line);
		text-decoration: none;
		color: var(--color-ink);
	}

	.index-title {
		display: block;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.index-item:hover .index-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.16em;
	}

	.index-blurb {
		display: block;
		margin-top: 0.35rem;
		font-size: 1.02rem;
		line-height: 1.45;
		color: var(--color-ink-soft);
	}

	.scaffold-note {
		margin-top: 2.75rem;
		font-family: var(--font-sans);
		font-size: 0.84rem;
		color: var(--color-ink-faint);
	}
</style>
