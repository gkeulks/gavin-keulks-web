				</li>
			</ul>
		</section>

		<p class="cv-line">
			A complete list of publications and papers is in the{' '}
			<a href="/documents/gavin-keulks-cv.pdf">curriculum vitae (PDF)</a>.
		</p>
	</div>
</Layout>

<style>
	.page-head {
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(1.75rem, 4vw, 3rem);
	}

	.page-head h1 {
		margin: 0 0 1rem;
	}

	.page-intro {
		font-size: clamp(1.1rem, 1rem + 0.6vw, 1.3rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
		max-width: 42rem;
		text-wrap: balance;
	}

	.archive,
	.work {
		padding-block: clamp(2.25rem, 5vw, 3.25rem);
		border-top: 1px solid var(--color-line);
	}

	.archive h2,
	.work h2 {
		margin: 0 0 1.35rem;
	}

	.archive p {
		margin: 0 0 1.15rem;
		max-width: 42rem;
	}

	.archive .record-list {
		margin-top: 1.5rem;
	}

	.record-list {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 42rem;
	}

	.record-row {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: 0 1.5rem;
		padding-block: 0.75rem;
		align-items: baseline;
	}

	.record-row + .record-row {
		border-top: 1px solid var(--color-line);
	}

	.record-year {
		font-family: var(--font-sans);
		font-size: 0.8rem;
		color: var(--color-ink-faint);
		font-variant-numeric: tabular-nums;
	}

	.record-item {
		font-size: 1rem;
		line-height: 1.45;
		color: var(--color-ink-soft);
	}

	.record-note {
		display: block;
		margin-top: 0.2rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		color: var(--color-ink-faint);
	}

	.cite-list {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 42rem;
	}

	.cite-list li {
		padding-block: 0.7rem;
		padding-left: 1.4rem;
		text-indent: -1.4rem;
		font-size: 1rem;
		line-height: 1.5;
		color: var(--color-ink-soft);
		text-wrap: pretty;
	}

	.cite-list li + li {
		border-top: 1px solid var(--color-line);
	}

	.cite-title {
		color: var(--color-ink);
	}

	.cv-line {
		margin: 0;
		padding-block: 1.35rem;
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
		font-family: var(--font-sans);
		font-size: 0.85rem;
		letter-spacing: 0.01em;
		color: var(--color-ink-faint);
	}

	.cv-line a {
		color: var(--color-ink-soft);
	}

	@media (max-width: 34rem) {
		.record-row {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
