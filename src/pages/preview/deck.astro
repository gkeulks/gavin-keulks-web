---
import Layout from '../../layouts/Layout.astro';
import SlideDeck from '../../components/SlideDeck.astro';

const modules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/images/decks/acis-2026/*.jpg',
	{ eager: true }
);
const slides = Object.keys(modules)
	.sort()
	.map((k) => modules[k].default);
---

<Layout
	title="Slide deck viewer"
	noindex
	description="Mock-up route: a slide-deck viewer for conference presentations, at two widths."
>
	<div class="wrap">
		<header class="mock-head">
			<p class="mock-kicker">Mock-up &mdash; not linked from the site</p>
			<h1>A viewer for the presentations</h1>
			<p class="mock-intro">
				The real ACIS deck &mdash; 45 slides, in order. Arrows and the counter
				beneath, click the slide to enlarge, arrow keys work once the deck has
				focus. The two versions differ only in width; A is the one I&rsquo;d
				take, for the reasons in chat. <strong>The slides are soft because the
				export is 720&times;405</strong> &mdash; that is the file, not the
				viewer.
			</p>
		</header>

		<p class="mock-label">A &mdash; in the reading column</p>
		<p class="mock-note">
			The stage runs to the same 1024 edge as every rule on the site. The deck
			reads as part of the page rather than as an interruption.
		</p>
	</div>

	<SlideDeck slides={slides} title="Home (Dis)Rule" meta="ACIS 2026" pdf="/documents/gavin-keulks-cv.pdf" />

	<div class="wrap">
		<p class="mock-label">B &mdash; the wide stage</p>
		<p class="mock-note">
			The same component at <code>--page-width-wide</code>, the 78rem measure
			reserved for the Fieldwork gallery and never yet used. Slides get roughly
			half again as much room; the band breaks out past the text column.
		</p>
	</div>

	<SlideDeck
		slides={slides}
		title="Home (Dis)Rule"
		meta="ACIS 2026"
		pdf="/documents/gavin-keulks-cv.pdf"
		wide
	/>

	<div class="wrap">
		<p class="mock-foot">
			The &ldquo;View as PDF&rdquo; link points at the CV here purely so it
			resolves &mdash; it would point at the deck itself.
		</p>
	</div>
</Layout>

<style>
	.mock-head {
		padding-block: clamp(3rem, 8vw, 4.5rem) 2rem;
	}

	.mock-head h1 {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 4vw, 2.6rem);
	}

	.mock-kicker {
		margin: 0 0 1.25rem;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.mock-intro {
		margin: 0;
		max-width: 34rem;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-ink-soft);
	}

	.mock-label {
		margin: 2.5rem 0 0.35rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.mock-note,
	.mock-foot {
		margin: 0 0 1.5rem;
		max-width: 34rem;
		font-family: var(--font-sans);
		font-size: 0.84rem;
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	.mock-foot {
		padding-block: 2.5rem 1rem;
	}
</style>
