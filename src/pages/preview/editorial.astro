---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import portrait from '../../assets/images/portrait.jpg';
import cambridgeCover from '../../assets/images/books/cambridge-companion.jpg';
import postmodernismCover from '../../assets/images/books/postmodernism-and-beyond.png';
import fatherAndSonCover from '../../assets/images/books/father-and-son.png';

const books = [
	{
		cover: cambridgeCover,
		title: 'The Cambridge Companion to Martin Amis',
		meta: 'Editor &middot; Cambridge University Press, 2026',
	},
	{
		cover: postmodernismCover,
		title: 'Martin Amis: Postmodernism and Beyond',
		meta: 'Editor &middot; Palgrave Macmillan, 2006',
	},
	{
		cover: fatherAndSonCover,
		title: 'Father and Son',
		meta: 'Author &middot; University of Wisconsin Press, 2003',
	},
];
---

<Layout
	title="Preview &mdash; Editorial"
	alwaysWordmark
	noindex
	description="Design mock-up."
>
	<section class="hero">
		<div class="wrap hero-inner">
			<h1>
				<span class="line-a">Writer</span>
				<span class="line-b">and scholar</span>
			</h1>
			<p class="standfirst">
				Twentieth-century English and Irish fiction of the postwar period &mdash;
				and the films, photographs, and advertising that grew up alongside it.
			</p>
			<Image
				class="portrait"
				src={portrait}
				alt="Gavin Keulks"
				widths={[320, 480, 640]}
				sizes="(max-width: 52rem) 62vw, 19rem"
			/>
		</div>
	</section>

	<section class="shelf-band">
		<div class="wrap">
			<p class="eyebrow">Three books, 2003&ndash;2026</p>
			<ul class="shelf">
				{
					books.map((b) => (
						<li class="shelf-item">
							<a class="shelf-link" href="/books/">
								<Image
									class="shelf-cover"
									src={b.cover}
									alt=""
									widths={[260, 390, 520]}
									sizes="(max-width: 52rem) 46vw, 15rem"
								/>
								<span class="shelf-title">{b.title}</span>
								<span class="shelf-meta" set:html={b.meta} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<div class="wrap">
		<section class="now">
			<p class="eyebrow">What I am working on</p>
			<ol class="now-list">
				<li>
					<span class="now-index">01</span>
					<div class="now-body">
						<h2><em>Flight</em></h2>
						<p class="now-meta">A novel &middot; Under agent&nbsp;review</p>
						<p>
							Complete at 80,000&nbsp;words, and perhaps the most meaningful thing
							I have written.
						</p>
						<a class="more" href="/creative-work/">Creative Work</a>
					</div>
				</li>
				<li>
					<span class="now-index">02</span>
					<div class="now-body">
						<h2>Irish traumatic spaces</h2>
						<p class="now-meta">A scholarly monograph &middot; In&nbsp;progress</p>
						<p>
							On the reclamation of traumatic spaces in Ireland &mdash; Magdalene
							Laundries, Mother and Baby Homes, Ghost Estates, Famine
							Walls/Roads/Graveyards &mdash; built from my own site-based
							photographs.
						</p>
						<a class="more" href="/fieldwork/">Fieldwork</a>
					</div>
				</li>
				<li>
					<span class="now-index">03</span>
					<div class="now-body">
						<h2>The Martin Amis Web</h2>
						<p class="now-meta">Digital archive &middot; British&nbsp;Library, 2012</p>
						<p>
							The authoritative digital archive for the author, designated a site
							of scholarly significance and archived twice a year as part of the
							UK Web Archive Project.
						</p>
						<a
							class="more"
							href="https://martinamisweb.com/"
							target="_blank"
							rel="noopener noreferrer">martinamisweb.com</a
						>
					</div>
				</li>
			</ol>
		</section>

		<section class="closing">
			<p>
				My essays and chapters are collected on{' '}
				<a href="/scholarship/">Scholarship</a>. I take on{' '}
				<a href="/consulting/">external program review and assessment</a>, keep a{' '}
				<a href="/teaching/">teaching portfolio</a>, and there is a{' '}
				<a href="/about/">fuller account</a> of the rest.
			</p>
		</section>
	</div>
</Layout>

<style>
	/* Mock-up: Home gets its own rules. Bigger scale, asymmetry, a tinted band,
	   and the covers carrying the colour. Interior pages are untouched. */
	.hero {
		border-bottom: 1px solid var(--color-line);
	}

	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			'title portrait'
			'stand portrait';
		align-items: end;
		column-gap: 3rem;
		padding-block: clamp(3rem, 9vw, 6rem) clamp(2.5rem, 7vw, 4.5rem);
	}

	.hero h1 {
		grid-area: title;
		margin: 0 0 1.4rem;
		font-size: clamp(3rem, 10vw, 6.5rem);
		line-height: 0.94;
		letter-spacing: -0.035em;
		font-weight: 400;
	}

	.line-a,
	.line-b {
		display: block;
	}

	.line-b {
		font-style: italic;
		color: var(--color-ink-soft);
		padding-left: 0.08em;
	}

	.standfirst {
		grid-area: stand;
		margin: 0;
		max-width: 30rem;
		font-size: 1.08rem;
		line-height: 1.6;
		color: var(--color-ink-soft);
	}

	.portrait {
		grid-area: portrait;
		width: 19rem;
		height: auto;
		align-self: end;
		border-radius: 2px;
	}

	.eyebrow {
		margin: 0 0 1.5rem;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
	}

	.shelf-band {
		background: var(--color-paper-raised);
		border-bottom: 1px solid var(--color-line);
		padding-block: clamp(2.75rem, 7vw, 4.25rem);
	}

	.shelf {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shelf-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	/* One shared cover height so the three spines sit on a common baseline. */
	.shelf-cover {
		display: block;
		height: clamp(11rem, 17vw, 14.5rem);
		width: auto;
		max-width: 100%;
		border: 1px solid var(--color-line);
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.13);
		transition: transform 0.18s ease;
	}

	.shelf-link:hover .shelf-cover {
		transform: translateY(-3px);
	}

	.shelf-title {
		display: block;
		margin-top: 1rem;
		max-width: 15rem;
		font-size: 1.05rem;
		line-height: 1.28;
	}

	.shelf-meta {
		display: block;
		margin-top: 0.3rem;
		font-family: var(--font-sans);
		font-size: 0.76rem;
		color: var(--color-ink-faint);
	}

	.now {
		padding-block: clamp(2.75rem, 7vw, 4.25rem);
	}

	.now-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 2.5rem;
	}

	.now-list li {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		gap: 1rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--color-line);
	}

	.now-index {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--color-ink-faint);
		padding-top: 0.45rem;
	}

	.now-body h2 {
		margin: 0 0 0.3rem;
		font-size: 1.45rem;
	}

	.now-meta {
		margin: 0 0 0.65rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		color: var(--color-ink-faint);
	}

	.now-body p {
		margin: 0;
		max-width: 36rem;
	}

	.more {
		display: inline-block;
		margin-top: 0.8rem;
		font-family: var(--font-sans);
		font-size: 0.76rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.closing {
		padding-block: clamp(2rem, 5vw, 2.75rem);
		border-top: 1px solid var(--color-line);
	}

	.closing p {
		margin: 0;
		max-width: 42rem;
		color: var(--color-ink-soft);
	}

	@media (max-width: 52rem) {
		.hero-inner {
			grid-template-columns: 1fr;
			grid-template-areas:
				'portrait'
				'title'
				'stand';
			row-gap: 1.75rem;
		}

		.portrait {
			width: 62%;
			max-width: 16rem;
		}

		.shelf {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}

		.now-list li {
			grid-template-columns: 2.5rem minmax(0, 1fr);
		}
	}
</style>
