---
import '../../styles/preview.css';

const directions = [
	{
		slug: 'review',
		name: 'Review',
		line: 'Monochrome. Spectral throughout. Uppercase tracked nav, confident title-page scale. The spare literary quarterly — clearest break from the Martin Amis Web.',
	},
	{
		slug: 'monograph',
		name: 'Monograph',
		line: 'Source Serif 4, warm ivory, a bottle-green accent, a double-rule motif. A well-set university-press book.',
	},
	{
		slug: 'field',
		name: 'Field',
		line: 'Newsreader headings over Inter body text, cool paper, generous air, nav set to the right. Photo-forward and modern; the shell nearly disappears.',
	},
];
---

<!doctype html>
<html lang="en" data-direction="review">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Design direction previews</title>
	</head>
	<body class="pv-body">
		<div class="pv-banner">
			Design previews &mdash; temporary, unlinked, <code>noindex</code>.
			<a href="/">Back to the live site</a>
		</div>

		<main class="pv-wrap pv-main">
			<article class="pv-article">
				<p class="pv-eyebrow">Choosing a direction</p>
				<h1>Three ways the site could look</h1>
				<p class="pv-lead">
					Each link below opens the same draft &ldquo;About&rdquo; page &mdash;
					identical words, identical structure &mdash; rendered in a different
					design system. Compare them on whatever device you like. Once you pick
					one, these get deleted.
				</p>

				<h2>The directions</h2>
				<ul class="pv-list">
					{
						directions.map((d) => (
							<li>
								<a href={`/preview/${d.slug}/`}>
									<strong>{d.name}</strong>
								</a>
								{' '}&mdash; {d.line}
							</li>
						))
					}
				</ul>

				<p>
					They differ on all four fronts at once &mdash; typeface, colour,
					chrome, and spacing &mdash; because those choices only make sense
					together. Tell me what lands, what doesn&rsquo;t, and what you&rsquo;d
					pull from one into another.
				</p>
			</article>
		</main>
	</body>
</html>
