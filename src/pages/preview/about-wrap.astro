</Layout>

<style>
	.page-head {
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(1.75rem, 4vw, 3rem);
	}

	.tag {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		margin: 0 0 2.5rem;
	}

	.mock-h1 {
		font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
		margin: 0 0 1rem;
	}

	.page-intro {
		font-size: clamp(1.1rem, 1rem + 0.6vw, 1.3rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
		max-width: 42rem;
	}

	section {
		padding-block: 4rem 2rem;
	}

	.fig {
		margin: 0;
		width: 13rem;
	}

	.fig-img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 2px;
	}

	p:not(.tag):not(.page-intro) {
		margin: 0 0 1.15rem;
	}

	/* D: the figure shares the header row; the rule simply sits below both. */
	.vd-head {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: start;
	}

	.vd-bio {
		margin-top: clamp(1.75rem, 4vw, 3rem);
		border-top: 1px solid var(--color-line);
		padding-top: 3.75rem;
		max-width: 42rem;
	}

	/* D2: the figure floats up out of the bio, past a shortened rule. */
	.vd2-head {
		margin-bottom: clamp(1.75rem, 4vw, 3rem);
	}

	.vd2-bio {
		position: relative;
		padding-top: 3.75rem;
		max-width: 48rem;
	}

	.vd2-bio::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 35rem;
		height: 1px;
		background: var(--color-line);
	}

	.vd2-bio .fig {
		float: right;
		margin: -8.6rem 0 1rem 2rem;
	}

	.vd2-bio p:not(.tag) {
		max-width: 42rem;
	}

	/* C: float wholly inside the prose measure. */
	.vc-bio {
		border-top: 1px solid var(--color-line);
		padding-top: 3.75rem;
		max-width: 42rem;
	}

	.vc-bio .fig {
		float: right;
		margin: 0 0 1rem 2rem;
	}
</style>
