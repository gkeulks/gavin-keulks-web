	</div>
</Layout>

<style>
	.page-head {
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(1.75rem, 4vw, 3rem);
	}

	.tag {
		font-family: var(--font-sans);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink-faint);
		margin: 0 0 1.5rem;
	}

	.bio {
		padding-block: clamp(2.5rem, 6vw, 3.75rem);
		border-top: 1px solid var(--color-line);
	}

	.variant-c {
		max-width: 42rem;
	}

	.beside-figure {
		float: right;
		margin: 0 0 1rem 2rem;
		width: 13rem;
	}

	.beside-image {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 2px;
	}

	.bio p {
		margin: 0 0 1.15rem;
	}

	.bio p:last-child {
		margin-bottom: 0;
	}
</style>
