---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import portrait from '../../assets/images/portrait.jpg';
import cambridgeCover from '../../assets/images/books/cambridge-companion.jpg';
import postmodernismCover from '../../assets/images/books/postmodernism-and-beyond.png';
import fatherAndSonCover from '../../assets/images/books/father-and-son.png';

const books = [
	{
		cover: cambridgeCover,
		title: 'The Cambridge Companion to Martin Amis',
		meta: 'Cambridge University Press, 2026',
		role: 'Editor',
	},
	{
		cover: postmodernismCover,
		title: 'Martin Amis: Postmodernism and Beyond',
		meta: 'Palgrave Macmillan, 2006',
		role: 'Editor',
	},
	{
		cover: fatherAndSonCover,
		title: 'Father and Son',
		meta: 'University of Wisconsin Press, 2003',
		role: 'Author',
	},
];
---

<Layout
	title="Preview &mdash; Accent"
	alwaysWordmark
	noindex
	description="Design mock-up."
>
	<div class="wrap">
		<section class="hero">
			<div class="hero-text">
				<p class="eyebrow">Writer and scholar</p>
				<h1>Gavin Keulks</h1>
				<p class="lede">
					I write about twentieth-century English and Irish fiction of the postwar
					period, and about the films and advertising that grew up alongside it.
					Three books so far, a fourth in the making, and a first novel now with
					agents.
				</p>
			</div>
			<Image
				class="portrait"
				src={portrait}
				alt="Gavin Keulks"
				widths={[256, 384, 512]}
				sizes="(max-width: 46rem) 45vw, 14rem"
			/>
		</section>

		<section class="band">
			<p class="eyebrow">Books</p>
			<ul class="shelf">
				{
					books.map((b) => (
						<li class="shelf-item">
							<a class="shelf-link" href="/books/">
								<Image
									class="shelf-cover"
									src={b.cover}
									alt=""
									widths={[220, 330, 440]}
									sizes="(max-width: 46rem) 40vw, 13rem"
								/>
								<span class="shelf-role">{b.role}</span>
								<span class="shelf-title">{b.title}</span>
								<span class="shelf-meta">{b.meta}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="band">
			<p class="eyebrow">Current work</p>
			<div class="pair">
				<article class="work">
					<h2><em>Flight</em></h2>
					<p class="work-meta">A novel &middot; Under agent&nbsp;review</p>
					<p>
						Complete at 80,000&nbsp;words, and perhaps the most meaningful thing I
						have written. <a href="/creative-work/">Creative Work</a>
					</p>
				</article>
				<article class="work">
					<h2>Irish traumatic spaces</h2>
					<p class="work-meta">A scholarly monograph &middot; In&nbsp;progress</p>
					<p>
						On the reclamation of traumatic spaces in Ireland &mdash; Magdalene
						Laundries, Mother and Baby Homes, Ghost Estates, Famine
						Walls/Roads/Graveyards &mdash; built from my own site-based
						photographs. <a href="/fieldwork/">Fieldwork</a>
					</p>
				</article>
			</div>
		</section>

		<section class="band closing">
			<p>
				I created and administer{' '}
				<a href="https://martinamisweb.com/" target="_blank" rel="noopener noreferrer"
					>the Martin&nbsp;Amis Web</a
				>, the authoritative digital archive for that author, designated a site of
				scholarly significance by the British&nbsp;Library in 2012. My essays and
				chapters are collected on{' '}
				<a href="/scholarship/">Scholarship</a>; I also take on{' '}
				<a href="/consulting/">external program review</a> and keep a{' '}
				<a href="/teaching/">teaching portfolio</a>.
			</p>
		</section>
	</div>
</Layout>

<style>
	/* Mock-up: the monochrome system, unchanged, plus one accent drawn from the
	   Father and Son cover. Claret #7a1f38 sits at 9.5:1 on the bone paper and
	   #d98fa3 at 7.4:1 on the dark ground, so both clear AAA for body text. */
	.wrap {
		--accent: #7a1f38;
		--accent-soft: #f0e2e5;
	}

	:global(:root[data-theme='dark']) .wrap {
		--accent: #d98fa3;
		--accent-soft: #2a1c20;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .wrap {
			--accent: #d98fa3;
			--accent-soft: #2a1c20;
		}
	}

	.eyebrow {
		margin: 0 0 1.25rem;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.hero {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: start;
		gap: 3rem;
		padding-block: clamp(3rem, 8vw, 5rem) clamp(2.5rem, 6vw, 4rem);
	}

	.hero h1 {
		margin: 0 0 1.1rem;
		font-size: clamp(2.6rem, 6.5vw, 4.1rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 0;
		max-width: 34rem;
		font-size: 1.12rem;
		line-height: 1.62;
		color: var(--color-ink-soft);
	}

	.portrait {
		width: 14rem;
		height: auto;
		border-radius: 2px;
	}

	.band {
		padding-block: clamp(2.5rem, 6vw, 3.75rem);
		border-top: 1px solid var(--color-line);
	}

	.shelf {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shelf-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	/* One shared cover height so the three spines sit on a common baseline and
	   the captions below them start at the same y. Widths differ; that is the
	   bookshelf, not a fault. */
	.shelf-cover {
		display: block;
		height: clamp(11rem, 17.5vw, 14rem);
		width: auto;
		max-width: 100%;
		border: 1px solid var(--color-line);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.07);
	}

	.shelf-role {
		display: block;
		margin-top: 0.9rem;
		font-family: var(--font-sans);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.shelf-title {
		display: block;
		margin-top: 0.3rem;
		font-size: 1.02rem;
		line-height: 1.3;
		max-width: 13rem;
	}

	.shelf-link:hover .shelf-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.shelf-meta {
		display: block;
		margin-top: 0.25rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		color: var(--color-ink-faint);
	}

	.pair {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2.5rem;
	}

	.work h2 {
		margin: 0 0 0.35rem;
		font-size: 1.35rem;
	}

	.work-meta {
		margin: 0 0 0.7rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: var(--color-ink-faint);
	}

	.work p {
		margin: 0;
		max-width: 28rem;
	}

	.closing p {
		margin: 0;
		max-width: 42rem;
		color: var(--color-ink-soft);
	}

	.wrap a {
		color: var(--accent);
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
		text-underline-offset: 2px;
	}

	.wrap .shelf-link {
		color: var(--color-ink);
	}

	@media (max-width: 46rem) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.portrait {
			width: 11rem;
			order: -1;
		}

		.shelf {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.pair {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
