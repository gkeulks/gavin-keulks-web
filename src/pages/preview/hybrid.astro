---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import portrait from '../../assets/images/portrait.jpg';
import cambridgeCover from '../../assets/images/books/cambridge-companion.jpg';
import postmodernismCover from '../../assets/images/books/postmodernism-and-beyond.png';
import fatherAndSonCover from '../../assets/images/books/father-and-son.png';

const books = [
	{
		cover: cambridgeCover,
		title: 'The Cambridge Companion to Martin Amis',
		meta: 'Editor &middot; Cambridge University Press, 2026',
	},
	{
		cover: postmodernismCover,
		title: 'Martin Amis: Postmodernism and Beyond',
		meta: 'Editor &middot; Palgrave Macmillan, 2006',
	},
	{
		cover: fatherAndSonCover,
		title: 'Father and Son',
		meta: 'Author &middot; University of Wisconsin Press, 2003',
	},
];
---

<Layout
	title="Preview &mdash; Hybrid"
	alwaysWordmark
	noindex
	description="Design mock-up."
>
	<div class="wrap">
		<section class="hero">
			<div class="hero-text">
				<h1>Gavin Keulks</h1>
				<p class="lede">
					Professor of literature and film at Western Oregon University,
					specializing in twentieth-century English and Irish fiction of the
					postwar period. Editor of{' '}
					<em>The Cambridge&nbsp;Companion to Martin&nbsp;Amis</em> and
					administrator of the Martin&nbsp;Amis Web. I also take on external
					program review contracts for honors programs and English departments.
				</p>
			</div>
			<Image
				class="portrait"
				src={portrait}
				alt="Gavin Keulks"
				widths={[256, 384, 512]}
				sizes="(max-width: 46rem) 45vw, 14rem"
			/>
		</section>
	</div>

	<section class="shelf-band">
		<div class="wrap">
			<p class="eyebrow">Three books, 2003&ndash;2026</p>
			<ul class="shelf">
				{
					books.map((b) => (
						<li class="shelf-item">
							<a class="shelf-link" href="/books/">
								<Image
									class="shelf-cover"
									src={b.cover}
									alt=""
									widths={[260, 390, 520]}
									sizes="(max-width: 52rem) 46vw, 15rem"
								/>
								<span class="shelf-title">{b.title}</span>
								<span class="shelf-meta" set:html={b.meta} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<div class="wrap">
		<section class="now">
			<p class="eyebrow">What I am working on</p>
			<ol class="now-list">
				<li>
					<span class="now-index">01</span>
					<div class="now-body">
						<h2><em>Flight</em></h2>
						<p class="now-meta">My first novel &middot; Under agent&nbsp;review</p>
						<p>
							Complete at 80,000&nbsp;words, and perhaps the most meaningful thing
							I have written.
						</p>
						<a class="more" href="/creative-work/">Creative Work</a>
					</div>
				</li>
				<li>
					<span class="now-index">02</span>
					<div class="now-body">
						<h2>Irish Traumatic Spaces</h2>
						<p class="now-meta">
							My next scholarly monograph &middot; In&nbsp;progress
						</p>
						<p>
							On the reclamation of traumatic spaces in Ireland &mdash; Magdalene
							Laundries, Mother and Baby Homes, Ghost Estates, Famine
							Walls/Roads/Graveyards &mdash; built from my own site-based
							photographs.
						</p>
						<a class="more" href="/fieldwork/">Fieldwork</a>
					</div>
				</li>
				<li>
					<span class="now-index">03</span>
					<div class="now-body">
						<h2>The Martin Amis Web</h2>
						<p class="now-meta">Web administration</p>
						<p>
							The authoritative digital archive for one of England&rsquo;s most
							important contemporary writers. Designated a site of scholarly
							significance by the British&nbsp;Library and archived every six
							months as part of their UK Web Archive&nbsp;Project.
						</p>
						<a
							class="more"
							href="https://martinamisweb.com/"
							target="_blank"
							rel="noopener noreferrer">martinamisweb.com</a
						>
					</div>
				</li>
			</ol>
		</section>
	</div>
</Layout>

<style>
	/* Hybrid: Accent's hero (eyebrow removed), Editorial's cover band and
	   numbered current-work list. Claret accent kept on links and eyebrows —
	   delete the two --accent blocks and the `.wrap a` rule to drop it. */
	.wrap {
		--accent: #7a1f38;
	}

	:global(:root[data-theme='dark']) .wrap {
		--accent: #d98fa3;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .wrap {
			--accent: #d98fa3;
		}
	}

	.hero {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: start;
		gap: 3rem;
		padding-block: clamp(3rem, 8vw, 5rem) clamp(2.5rem, 6vw, 4rem);
	}

	.hero h1 {
		margin: 0 0 1.1rem;
		font-size: clamp(2.6rem, 6.5vw, 4.1rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 0;
		max-width: 34rem;
		font-size: 1.12rem;
		line-height: 1.62;
		color: var(--color-ink-soft);
	}

	.portrait {
		width: 14rem;
		height: auto;
		border-radius: 2px;
	}

	.eyebrow {
		margin: 0 0 1.5rem;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.shelf-band {
		background: var(--color-paper-raised);
		border-block: 1px solid var(--color-line);
		padding-block: clamp(2.75rem, 7vw, 4.25rem);
	}

	.shelf {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.shelf-link {
		display: block;
		text-decoration: none;
	}

	/* One shared cover height so the three spines sit on a common baseline. */
	.shelf-cover {
		display: block;
		height: clamp(11rem, 17vw, 14.5rem);
		width: auto;
		max-width: 100%;
		border: 1px solid var(--color-line);
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.13);
		transition: transform 0.18s ease;
	}

	.shelf-link:hover .shelf-cover {
		transform: translateY(-3px);
	}

	.shelf-title {
		display: block;
		margin-top: 1rem;
		max-width: 15rem;
		font-size: 1.05rem;
		line-height: 1.28;
	}

	.shelf-meta {
		display: block;
		margin-top: 0.3rem;
		font-family: var(--font-sans);
		font-size: 0.76rem;
		color: var(--color-ink-faint);
	}

	.now {
		padding-block: clamp(2.75rem, 7vw, 4.25rem);
	}

	.now-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 2.5rem;
	}

	.now-list li {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		gap: 1rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--color-line);
	}

	.now-index {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--accent);
		padding-top: 0.45rem;
	}

	.now-body h2 {
		margin: 0 0 0.3rem;
		font-size: 1.45rem;
	}

	.now-meta {
		margin: 0 0 0.65rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		color: var(--color-ink-faint);
	}

	.now-body p {
		margin: 0;
		max-width: 36rem;
	}

	.more {
		display: inline-block;
		margin-top: 0.8rem;
		font-family: var(--font-sans);
		font-size: 0.76rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}

	.wrap a {
		color: var(--accent);
		text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
		text-underline-offset: 2px;
	}

	.wrap .shelf-link {
		color: var(--color-ink);
	}

	@media (max-width: 46rem) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.portrait {
			width: 11rem;
			order: -1;
		}
	}

	@media (max-width: 52rem) {
		.shelf {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}

		.now-list li {
			grid-template-columns: 2.5rem minmax(0, 1fr);
		}
	}
</style>
