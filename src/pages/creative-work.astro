---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import workshopping from '../assets/images/workshopping.jpg';
---

<Layout
	title="Creative Work"
	description="Gavin Keulks — Flight, a novel of literary fiction about risk, resistance, and the barriers people build around their lives; plus poems published in The Antigonish Review and The Merton Journal."
>
	<div class="wrap">
		<header class="page-head">
			<h1>Creative Work</h1>
			<p class="page-intro">A novel and published poems.</p>
		</header>

		<section class="work">
			<h2><em>Flight</em></h2>
			<p class="work-meta">A novel &middot; 80,000 words &middot; Under agent&nbsp;review</p>
			<div class="beside">
				<div class="beside-text">
					<p>
						<em>Flight</em> is a work of literary fiction about risk and
						resistance, light and dark energies&nbsp;&mdash; and the barriers
						people create to preserve their comfortable, ziplocked lives.
					</p>
					<p>
						Structured in six sections that correspond to spiritual dates and
						martyrs, the novel dramatizes two months in the life of a woman who
						works in an exotic bird store. Her best friend is a circus
						contortionist. She has three love interests: a bashful policeman, an
						egomaniacal astrophysicist, and a distant fianc&eacute;. At the
						center of her story is Maddie, a yellow-collared macaw.
					</p>
				</div>
				<figure class="beside-figure">
					<Image
						class="beside-image"
						src={workshopping}
						alt="Gavin Keulks reading aloud from a manuscript to a seated room"
						widths={[224, 336, 448]}
						sizes="(max-width: 46rem) 40vw, 13rem"
					/>
					<figcaption>Workshopping the manuscript</figcaption>
				</figure>
			</div>
		</section>

		<section class="work">
			<h2>Poems</h2>
			<ul class="cite-list">
				<li>
					<span class="cite-title"
						>&ldquo;Trappists&rdquo; and &ldquo;Houdini.&rdquo;</span
					>{' '}
					<em>The Antigonish Review</em> 153 (Summer 2008): 76&ndash;79.
				</li>
				<li>
					<span class="cite-title">&ldquo;Retreating.&rdquo;</span>{' '}
					<em>The Merton Journal</em> 15.1 (Eastertide 2008): 12&ndash;13.{' '}
					<a
						href="https://thomasmertonsociety.org/Journal/15/15-1Keulks.pdf" target="_blank" rel="noopener noreferrer"
						>thomasmertonsociety.org (PDF)</a
					>
				</li>
				<li>
					<span class="cite-title"
						>&ldquo;The Shower (for Thomas&nbsp;Merton).&rdquo;</span
					>{' '}
					<em>The Merton Journal</em> 10.2 (Advent 2003): 13&ndash;14. Read by the
					editor at the annual meeting of the Thomas&nbsp;Merton Society of
					Great&nbsp;Britain and Ireland.{' '}
					<a
						href="https://thomasmertonsociety.org/Journal/10/10-2Keulks.pdf" target="_blank" rel="noopener noreferrer"
						>thomasmertonsociety.org (PDF)</a
					>
				</li>
			</ul>
		</section>
	</div>
</Layout>

<style>
	.page-head {
		padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(1.75rem, 4vw, 3rem);
	}

	.page-head h1 {
		margin: 0 0 1rem;
	}

	.page-intro {
		font-size: clamp(1.1rem, 1rem + 0.6vw, 1.3rem);
		line-height: 1.5;
		color: var(--color-ink-soft);
		margin: 0;
		max-width: 42rem;
		text-wrap: balance;
	}

	.work {
		padding-block: clamp(2.25rem, 5vw, 3.25rem);
		border-top: 1px solid var(--color-line);
	}

	.work:last-child {
		border-bottom: 1px solid var(--color-line);
	}

	.work h2 {
		margin: 0 0 0.35rem;
	}

	.work h2 em {
		font-style: italic;
	}

	.work-meta {
		margin: 0 0 1.35rem;
		font-family: var(--font-sans);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		color: var(--color-ink-faint);
	}

	.beside {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: start;
	}

	.beside-text p {
		max-width: none;
	}

	/* The figure sets the width so the picture and its caption share one
	   right edge, on the page's 1024 rule. */
	.beside-figure {
		margin: 0;
		width: 13rem;
	}

	.beside-image {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 2px;
	}

	.beside-figure figcaption {
		margin-top: 0.6rem;
		font-family: var(--font-sans);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: var(--color-ink-faint);
	}

	.work p {
		margin: 0 0 1rem;
		max-width: 42rem;
	}

	.work p:last-child {
		margin-bottom: 0;
	}

	.cite-list {
		list-style: none;
		margin: 0;
		padding: 0;
		max-width: 42rem;
	}

	.cite-list li {
		padding-block: 0.7rem;
		padding-left: 1.4rem;
		text-indent: -1.4rem;
		font-size: 1rem;
		line-height: 1.5;
		color: var(--color-ink-soft);
		text-wrap: pretty;
	}

	.cite-list li + li {
		border-top: 1px solid var(--color-line);
	}

	.cite-title {
		color: var(--color-ink);
	}

	@media (max-width: 46rem) {
		.beside {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
